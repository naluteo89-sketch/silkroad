    },
    "{{STEPS}}": {
      "node": "62",
      "input": "steps",
      "source": "preset.steps",
      "type": "number"
    },
    "{{CFG}}": {
      "node": "63",
      "input": "cfg",
      "source": "preset.cfg",
      "type": "number"
    }
  },
  "output": {
    "node": "9",
    "class_type": "SaveImage",
    "note": "이 노드의 이미지 출력만 결과로 사용"
