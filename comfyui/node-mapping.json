      "type": "string"
    },
    "{{POSITIVE}}": {
      "node": "74",
      "input": "text",
      "source": "preset.positive",
      "type": "string"
    },
    "{{NEGATIVE}}": {
      "node": "67",
      "input": "text",
      "source": "preset.negative",
      "type": "string"
    },
    "{{SEED}}": {
      "node": "73",
      "input": "noise_seed",
      "source": "preset.seed on first send; preset.seedControl=randomize on retry",
