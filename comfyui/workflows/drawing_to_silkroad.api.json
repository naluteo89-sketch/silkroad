{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Checkpoint" },
    "inputs": {
      "ckpt_name": "animagineXL_v31.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive (preset)" },
    "inputs": {
      "text": "{{POSITIVE}}",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative (preset)" },
    "inputs": {
      "text": "{{NEGATIVE}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": { "title": "Input drawing (Unity)" },
    "inputs": {
      "image": "{{INPUT_IMAGE}}"
    }
  },
  "5": {
    "class_type": "ImageScale",
    "_meta": { "title": "Normalize size 16:9" },
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "lanczos",
      "width": 1280,
      "height": 720,
      "crop": "center"
    }
  },
  "6": {
    "class_type": "Canny",
    "_meta": { "title": "Line/edge condition" },
    "inputs": {
      "image": ["5", 0],
      "low_threshold": 0.2,
      "high_threshold": 0.5
    }
  },
  "7": {
    "class_type": "ControlNetLoader",
    "_meta": { "title": "SDXL Canny ControlNet FP16" },
    "inputs": {
      "control_net_name": "Hishambarakat__controlnet__controlnet-canny-sdxl-1.0.fp16.safetensors"
    }
  },
  "8": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": { "title": "Apply structure condition" },
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["7", 0],
      "image": ["6", 0],
      "strength": 0.45,
      "start_percent": 0.0,
      "end_percent": 0.7,
      "vae": ["1", 2]
    }
  },
  "13": {
    "class_type": "ImageBlur",
    "_meta": { "title": "Soften drawing" },
    "inputs": {
      "image": ["5", 0],
      "blur_radius": 2,
      "sigma": 2.0
    }
  },
  "9": {
    "class_type": "VAEEncode",
    "_meta": { "title": "img2img source (colors/layout)" },
    "inputs": {
      "pixels": ["13", 0],
      "vae": ["1", 2]
    }
  },
  "10": {
    "class_type": "KSampler",
    "_meta": { "title": "Sampler" },
    "inputs": {
      "seed": 123456789,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.75,
      "model": ["1", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["9", 0]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" },
    "inputs": {
      "samples": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "_meta": { "title": "OUTPUT" },
    "inputs": {
      "filename_prefix": "silkroad/result",
      "images": ["11", 0]
    }
  }
}